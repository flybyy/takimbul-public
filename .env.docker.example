# TakımBul Docker local environment
APP_PORT=8080
APP_URL=http://localhost:8080
APP_ENV=local
APP_DEBUG=true

DB_DATABASE=takimbul
DB_USERNAME=takimbul
DB_PASSWORD=takimbul_local_password
DB_ROOT_PASSWORD=takimbul_local_root_password

# Optional: first admin account will be created/updated when this is non-empty.
# Use at least 12 characters and change this before sharing a running environment.
TAKIMBUL_ADMIN_PASSWORD=
